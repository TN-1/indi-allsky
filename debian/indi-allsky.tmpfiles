# Runtime directories for indi-allsky
# See tmpfiles.d(5) for details
d /var/lib/indi-allsky                  0755 indi-allsky indi-allsky -
d /var/lib/indi-allsky/backup           0775 indi-allsky indi-allsky -
d /var/log/indi-allsky                  0755 indi-allsky indi-allsky -
d /etc/indi-allsky                      0755 indi-allsky indi-allsky -
d /var/www/html/allsky                  0775 indi-allsky www-data    -
d /var/www/html/allsky/images           0775 indi-allsky www-data    -
d /var/www/html/allsky/images/darks     0775 indi-allsky www-data    -
d /var/www/html/allsky/images/export    0775 indi-allsky www-data    -
